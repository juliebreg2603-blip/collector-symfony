{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de commande{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Vérification de votre commande</h1>

    <div class="row mt-4">
        {# Colonne de gauche : Liste des produits #}
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Vos articles</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Quantité</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                                <tr>
                                    <td><strong>{{ item.product.title }}</strong></td>
                                    <td>x {{ item.quantity }}</td>
                                    <td class="text-end">{{ item.product.price * item.quantity }} €</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Colonne de droite : Total et Validation #}
        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title">Résumé</h5>
                    <div class="d-flex justify-content-between mt-3">
                        <span>Total à régler :</span>
                        <span class="h4 fw-bold text-success">{{ total }} €</span>
                    </div>
                    <hr>
                    <p class="small text-muted">
                        Vérifiez bien vos articles avant de confirmer.
                    </p>
                    
                    {# Ce bouton appelle la route de confirmation finale #}
                    <a href="{{ path('app_cart_confirm') }}" class="btn btn-success w-100 py-2">
                        ✅ Confirmer et Payer
                    </a>
                    
                    <a href="{{ path('app_cart_index') }}" class="btn btn-link w-100 mt-2 text-decoration-none text-muted">
                        Modifier le panier
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
