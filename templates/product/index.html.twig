{% extends 'base.html.twig' %}

{% block title %}Accueil - collect'OR{% endblock %}

{% block body %}
    {# --- SECTION HERO SOBRE --- #}
    <div style="position: relative; width: 100vw; margin-left: calc(-50vw + 50%); height: 80vh; overflow: hidden; background: #000; margin-top: -40px;">
        
        {# Image Minimaliste : Noir et Blanc / Sombre #}
        <img src="https://images.unsplash.com/photo-1445985543470-41fba5c3144a?q=80&w=2070&auto=format&fit=crop" 
             style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; z-index: 1;">

        <div style="position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 0 20px;">
            <h1 style="margin: 0; padding: 0; line-height: 1.1; font-weight: 800; text-transform: uppercase;">
                <span style="display: block; font-size: clamp(30px, 8vw, 70px); color: white;">
                    DÉNICHEZ <span style="background: linear-gradient(to right, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">L'ARTICLE RARE.</span>
                </span>
                <span style="display: block; font-size: clamp(20px, 5vw, 45px); color: white; margin-top: 10px; font-weight: 400;">
                    CONNECTEZ-VOUS À L'ARTISTE.
                </span>
            </h1>

            <div style="max-width: 850px; margin: 30px auto;">
                <p style="color: #ccc; font-size: 18px; line-height: 1.6; font-weight: 300; text-shadow: 1px 1px 3px rgba(0,0,0,0.9);">
                    Bienvenue sur <strong>Collect'OR</strong>, la plateforme incontournable pour les passionnés de musique.
                </p>
            </div>

            <a href="#catalogue" style="background: linear-gradient(to right, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C); color: #000; padding: 18px 45px; border-radius: 50px; text-decoration: none; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; transition: 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                Explorer le catalogue
            </a>
        </div>
    </div>

    {# --- SECTION CATALOGUE --- #}
    <div id="catalogue" style="padding: 80px 0 50px 0; max-width: 1200px; margin: 0 auto;">
        <h2 style="font-size: 18px; font-weight: 300; text-transform: lowercase; margin-bottom: 50px; color: #fff; letter-spacing: 3px; display: flex; align-items: center;">
            <span style="color: #BF953F; font-weight: bold; margin-right: 15px;">//</span> nos coups de coeur du moment
        </h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 40px;">
            {% for product in products %}
                <div style="transition: 0.3s;">
                    <div style="width: 100%; aspect-ratio: 1/1; background: #111; border-radius: 8px; overflow: hidden; margin-bottom: 20px; border: 1px solid rgba(255,255,255,0.05);">
                        {% if product.imageName %}
                            <img src="{{ asset('images/products/' ~ product.imageName) }}" alt="{{ product.title }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.9;">
                        {% else %}
                            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #1a1a1a; color: #333; font-size: 40px;">💽</div>
                        {% endif %}
                    </div>
                    <h3 style="font-size: 13px; text-transform: uppercase; margin: 0; letter-spacing: 1.5px; font-weight: 700; color: #fff;">{{ product.title }}</h3>
                    <p style="color: #666; font-size: 11px; margin: 6px 0 15px 0;">{{ product.category }}</p>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.05);">
                        <span style="font-size: 18px; font-weight: 800; color: #FCF6BA;">{{ product.price }} €</span>
                        <a href="{{ path('app_cart_add', {'id': product.id}) }}" style="color: #BF953F; text-decoration: none; font-size: 26px;">+</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
