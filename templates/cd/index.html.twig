{% extends 'base.html.twig' %}

{% block title %}Collection CD - Collect'OR{% endblock %}

{% block body %}
<style>
    .hero-banner {
        height: 350px;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1526218626217-dc65a29bb444?q=80&w=2000');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 2px solid #d4af37;
    }

    .premium-container {
        background-color: #000;
        border: 1px solid #d4af37;
        border-radius: 15px;
        padding: 30px;
        margin: 20px auto 50px auto;
        max-width: 95%;
    }

    .flex-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        justify-content: center;
    }

    .product-card-flex {
        width: 200px; 
        color: white;
    }

    .img-square-fixed {
        width: 200px;
        height: 200px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.6);
        border: 1px solid rgba(212, 175, 55, 0.2);
        transition: transform 0.3s ease;
    }

    .img-square-fixed:hover {
        transform: scale(1.05);
    }

    .gold-text { color: #d4af37; }
</style>

<div class="hero-banner">
    <h1 class="text-white text-uppercase fw-bold display-4">Univers CD</h1>
</div>

<div class="container-fluid">
    <div class="premium-container shadow-lg">
        <h2 class="gold-text mb-5 text-uppercase fw-bold text-center">Disques Compacts</h2>

        <div class="flex-grid">
            {% for product in products %}
                <div class="product-card-flex">
                    <a href="{{ path('app_product_show', {'id': product.id}) }}">
                        <img src="{{ asset('images/products/' ~ product.imageName) }}" 
                             class="img-square-fixed"
                             alt="{{ product.title }}"
                             onerror="this.src='https://placehold.co/200x200/222/d4af37?text=CD'">
                    </a>
                    
                    <div class="mt-2">
                        <h6 class="text-uppercase gold-text mb-1" style="font-size: 0.65rem; opacity: 0.8;">{{ product.category }}</h6>
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" style="text-decoration: none; color: white;"> 
                            <h5 class="fw-bold mb-1" style="font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ product.title }}</h5> 
                        </a>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fw-bold" style="font-size: 1.1rem;">{{ product.price }} €</span>
                            
                            {# AJOUT DIRECT AU PANIER #}
                            <a href="{{ path('app_cart_add', {'id': product.id}) }}" class="gold-text fw-bold fs-4" style="text-decoration: none;">+</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
